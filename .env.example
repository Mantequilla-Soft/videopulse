# Mongo user for Pulse. Dry run only reads `videos` and `embed-video`.
MONGODB_URI=mongodb://videopulse:CHANGE_ME@mongo.example:27017/threespeak?authSource=threespeak
DATABASE_NAME=threespeak

# Pancreas hot-set endpoint (Mantequilla-Soft/3speakchecks#93), its own key
PANCREAS_URL=https://pancreas.example
PANCREAS_API_KEY=CHANGE_ME
PANCREAS_TIMEOUT_MS=30000

# GET /status needs `Authorization: Bearer <STATUS_TOKEN>`; unset = /status off
STATUS_TOKEN=CHANGE_ME
PORT=3020
HOST=127.0.0.1

# Only dry run exists. DRY_RUN=false refuses to start.
DRY_RUN=true

RUN_CRON=5 * * * *
RUN_ON_START=true
LOG_DECISIONS=true

# Limits, as in the v1 spec
MAX_NEW_PER_RUN=1
MAX_IN_FLIGHT=5
CLAIM_TIMEOUT_MIN=120
